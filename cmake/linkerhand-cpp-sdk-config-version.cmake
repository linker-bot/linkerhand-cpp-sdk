# Compatibility is restricted to SDK major version 2.
set(PACKAGE_VERSION "2.2.1")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)

if(PACKAGE_FIND_VERSION_RANGE)
    if(PACKAGE_FIND_VERSION_MIN_MAJOR EQUAL 2 AND
       NOT PACKAGE_FIND_VERSION_MIN VERSION_GREATER PACKAGE_VERSION)
        if((PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE" AND
            NOT PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION_MAX) OR
           (PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND
            PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX))
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        endif()
    endif()
elseif(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL 2 AND
       NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
